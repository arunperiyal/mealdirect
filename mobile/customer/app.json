{
  "expo": {
    "name": "MealDirect",
    "slug": "mealdirect-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealdirect.customer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E23744",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mealdirect.customer"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "MealDirect",
      "shortName": "MealDirect",
      "themeColor": "#E23744",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "MealDirect uses a photo you choose as your profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "mealdirect",
    "owner": "mealdirect",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "21fb4117-08da-49e5-b65f-eb2ec72fc0d0"
      }
    }
  }
}
