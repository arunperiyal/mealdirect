# Production settings for deploy/docker-compose.prod.yml.
# Copy to .env.production (never commit it) and replace every value.
# The API refuses to start if a secret is missing, too short or an example value.

# Database (the compose file creates it with these)
# DB_PASSWORD: a long random string, e.g. from  openssl rand -base64 32
DB_USER=mealdirect
DB_PASSWORD=
DB_NAME=mealdirect

# Sign-in tokens: two different random strings of 32+ characters
#   openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Razorpay (Dashboard -> Account & Settings -> API Keys, and Webhooks).
# Leave both keys empty to run without online payments (cash only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional
LOG_LEVEL=info
# HTTP_PORT=80
# HTTPS_PORT=443
