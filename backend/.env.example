NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=mess_user
DB_PASSWORD=secure_password_here
DB_NAME=mess_app

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_REFRESH_EXPIRE=30d

# API Configuration
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Payment Gateway (Razorpay - use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@messapp.com

# Online payment (Razorpay) is offered only when this is true AND the keys are set.
# On hold for now: customers pay on delivery.
ONLINE_PAYMENTS_ENABLED=false
# Customers paying by UPI at the door pay this account (QR on the rider's phone)
MEALDIRECT_UPI_ID=
MEALDIRECT_UPI_NAME=MealDirect
# "Today" for rider cash settlement: minutes east of UTC (330 = India)
BUSINESS_UTC_OFFSET_MINUTES=330

# Behind a reverse proxy such as nginx, the number of proxies (usually 1) so
# rate limits see the real client IP. 0 when clients connect directly.
TRUST_PROXY=0
# Requests per 15 minutes per IP (defaults: 20 for sign-in, 30 for payments)
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_PAYMENT_MAX=30

# Logging
LOG_LEVEL=debug

# Environment
NODE_ENV=development
