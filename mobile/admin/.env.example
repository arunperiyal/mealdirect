# Backend base URL (no trailing slash, no /api). Optional in development: when unset, the app
# uses port 3000 on the computer it was loaded from (the page's host in a browser, the Expo
# dev server's host in Expo Go), so it keeps working when your network address changes.
# Set it to point somewhere else, e.g. a deployed API. EAS builds always set it.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
