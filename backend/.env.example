NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=mess_user
DB_PASSWORD=secure_password_here
DB_NAME=mess_app

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_REFRESH_EXPIRE=30d

# API Configuration
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Web apps allowed to call the API from a browser, comma-separated. Only used in
# production; development allows any origin (Expo serves each web app on its own port).
CORS_ORIGINS=

# Payment Gateway (Razorpay - use rzp_test_ keys outside production)
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: password reset codes, over any SMTP server (Gmail/Google Workspace with an app
# password, Zoho, Amazon SES, Brevo, Mailgun...). Without SMTP_HOST, or with these example
# values, development prints emails to the API log; production can't send them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465; port 587 upgrades to TLS by itself
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=MealDirect <noreply@yourdomain.com>
# Where the website's suggestions and feedback form sends messages (default: SMTP_USER)
# FEEDBACK_EMAIL=
# New accounts confirm their email with a code before using the app; false switches it off
REQUIRE_EMAIL_VERIFICATION=true

# Online payment (Razorpay) is offered only when this is true AND the keys are set.
# On hold for now: customers pay on delivery.
ONLINE_PAYMENTS_ENABLED=false
# The business day (rider cash settlement, order cutoffs, auto-ready): minutes east of UTC (330 = India)
BUSINESS_UTC_OFFSET_MINUTES=330
# Restaurants can have accepted delivery orders marked ready shortly before their delivery time.
# Set to false to stop this background job (for example on all but one API instance).
AUTO_READY_JOB=true
# Gives waiting orders to riders' auto-accept rules every minute. Same advice as AUTO_READY_JOB.
AUTO_ASSIGN_JOB=true

# Behind a reverse proxy such as nginx, the number of proxies (usually 1) so
# rate limits see the real client IP. 0 when clients connect directly.
TRUST_PROXY=0
# Requests per 15 minutes per IP (defaults: 20 for sign-in, 30 for payments)
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_PAYMENT_MAX=30

# Logging
LOG_LEVEL=debug

# Environment
NODE_ENV=development
