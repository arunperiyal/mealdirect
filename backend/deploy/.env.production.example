# Production settings for deploy/docker-compose.prod.yml.
# Copy to .env.production (never commit it) and replace every value.
# The API refuses to start if a secret is missing, too short or an example value.

# Database (the compose file creates it with these)
# DB_PASSWORD: a long random string, e.g. from  openssl rand -base64 32
DB_USER=mealdirect
DB_PASSWORD=
DB_NAME=mealdirect

# Sign-in tokens: two different random strings of 32+ characters
#   openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Razorpay (Dashboard -> Account & Settings -> API Keys, and Webhooks).
# Leave both keys empty to run without online payments (cash only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Online payment: keep false while it's on hold (customers pay on delivery)
ONLINE_PAYMENTS_ENABLED=false

# The web apps' addresses, comma-separated, so browsers may call the API
# e.g. https://app.example.com,https://partner.example.com,https://admin.example.com
CORS_ORIGINS=

# Email for password reset codes: any SMTP server (Google Workspace with an app password,
# Zoho, Amazon SES, Brevo, Mailgun...). Without it, "Forgot password?" can't send codes.
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MealDirect <noreply@yourdomain.com>
# Where the website's suggestions and feedback form sends messages (default: SMTP_USER)
# FEEDBACK_EMAIL=

# Optional
LOG_LEVEL=info
# HTTP_PORT=80
# HTTPS_PORT=443
